<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fray-rewrite</ToolCommandName>
    <PackageId>FrayNet.Rewriter</PackageId>
    <Description>IL rewriter (dotnet tool) for FrayNet: redirects Monitor/Thread/Interlocked/Task/async machinery in an assembly to the Fray engine so plain .NET code can be tested under controlled concurrency without source changes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fray\Fray.csproj" />
  </ItemGroup>

</Project>
